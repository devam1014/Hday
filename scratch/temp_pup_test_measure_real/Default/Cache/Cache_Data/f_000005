const __vite__css = "/* ==============================================================================\n   CINEMATIC BIRTHDAY SURPRISE — STYLESHEET\n   Accurate Rooftop Wall Countdown, Open-Sky Fireworks, Right-Edge Floating Heart\n   ============================================================================== */\n\n:root {\n  --color-bg-dark: #07090e;\n  --color-midnight: #0c101d;\n  --color-deep-indigo: #1e1b4b;\n  --color-gold-400: #fbbf24;\n  --color-gold-500: #f59e0b;\n  --color-gold-yellow: #FFC52E;\n  --color-gold-cream: #FFF2CC;\n  --color-cream: #fef3c7;\n  --color-rose-300: #fda4af;\n  --color-rose-500: #f43f5e;\n  --color-rose-600: #e11d48;\n  --color-text-main: #f8fafc;\n  --color-text-muted: #cbd5e1;\n\n  --font-serif-display: 'Cinzel', 'Playfair Display', Georgia, serif;\n  --font-serif-card: 'Cormorant Garamond', Georgia, serif;\n  --font-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  --font-script: 'Pinyon Script', cursive;\n}\n\n/* Reset & Base */\n*, *::before, *::after {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nhtml, body {\n  width: 100%;\n  min-height: 100%;\n  background-color: var(--color-bg-dark);\n  color: var(--color-text-main);\n  font-family: var(--font-sans);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  overflow-x: hidden;\n}\n\nbutton {\n  font-family: inherit;\n  cursor: pointer;\n  border: none;\n  background: none;\n  outline: none;\n}\n\nbutton:focus-visible {\n  outline: 2px solid var(--color-gold-400);\n  outline-offset: 3px;\n}\n\n/* Fade In Utility */\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(4px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.animate-fade-in {\n  animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n/* ==============================================================================\n   COVER PAGE: ROOFTOP BACKGROUND & COMPOSITION\n   Preserves cover.png composition byte-for-byte\n   ============================================================================== */\n.cover-page-root {\n  position: relative;\n  width: 100vw;\n  height: 100vh;\n  overflow: hidden;\n  background-color: var(--color-bg-dark);\n}\n\n.cover-background-container {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 1;\n}\n\n.cover-background-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center bottom;\n  display: block;\n}\n\n/* On mobile, shift object-position slightly so the seated girl remains visible on left */\n@media (max-width: 768px) {\n  .cover-background-image {\n    object-position: 28% bottom;\n  }\n}\n\n/* ==============================================================================\n   COUNTDOWN TIMER — EXACT WALL PLACEMENT & ELEVATION\n   - Anchored to the rendered background image's coordinate system\n   - Vertically centered on the visible rooftop wall (moved UP significantly)\n   - Horizontally centered between the seated girl and the lantern table\n   - 25-35% larger numerals in warm golden yellow (#FFC52E)\n   - Delicate, vertically centered botanical ornaments close to outer units\n   - Zero cards, zero background rectangles, zero glass panels, zero sky headings\n   ============================================================================== */\n.wall-countdown-positioner {\n  position: absolute;\n  z-index: 15;\n  /* Centered in the open wall area (65.2%) and vertically centered on the wall (83.2%) */\n  left: 65.2%;\n  top: 83.2%;\n  transform: translate(-50%, -50%);\n  width: auto;\n  pointer-events: none;\n  animation: timerFadeIn 0.8s ease forwards;\n}\n\n@keyframes timerFadeIn {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n/* On mobile, centered in visible wall portion between girl and right edge */\n.wall-countdown-positioner.is-mobile {\n  left: 38.4%;\n  top: 83.2%;\n  transform: translate(-50%, -50%);\n}\n\n.wall-countdown-track {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(0.7rem, 1.0vw, 1.15rem);\n  padding: 0;\n  margin: 0;\n  background: none !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n\n/* Delicate Botanical Laurel Sprig Ornaments — Symmetrical curved golden linework */\n.botanical-ornament {\n  width: clamp(20px, 1.8vw, 26px);\n  height: clamp(40px, 3.6vw, 52px);\n  color: var(--color-gold-yellow);\n  filter: drop-shadow(0 0 8px rgba(255, 197, 46, 0.65));\n  opacity: 0.95;\n  flex-shrink: 0;\n  margin: 0 clamp(0.1rem, 0.25vw, 0.4rem);\n}\n\n.botanical-ornament.flipped {\n  transform: scaleX(-1);\n}\n\n/* Individual Unit (Numeral + Label) */\n.wall-unit {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  min-width: clamp(56px, 4.5vw, 68px);\n}\n\n/* Large warm golden-yellow numerals (#FFC52E) — Elegant serif display */\n.wall-numeral {\n  font-family: var(--font-serif-display);\n  font-size: clamp(2.5rem, 3.6vw, 3.6rem);\n  font-weight: 700;\n  color: var(--color-gold-yellow);\n  line-height: 1;\n  letter-spacing: 0.04em;\n  font-variant-numeric: tabular-nums;\n  display: inline-block;\n  text-align: center;\n  /* Soft, realistic golden glow and subtle text shadow */\n  text-shadow:\n    0 0 12px rgba(255, 197, 46, 0.8),\n    0 0 24px rgba(245, 158, 11, 0.5),\n    0 2px 6px rgba(0, 0, 0, 0.95);\n}\n\n/* Small uppercase labels directly below in warm cream (#FFF2CC) */\n.wall-label {\n  font-family: var(--font-sans);\n  font-size: clamp(0.64rem, 0.72vw, 0.76rem);\n  text-transform: uppercase;\n  letter-spacing: 0.18em;\n  color: var(--color-gold-cream);\n  font-weight: 600;\n  margin-top: 0.35rem;\n  display: block;\n  text-align: center;\n  text-shadow:\n    0 1px 4px rgba(0, 0, 0, 0.9),\n    0 0 6px rgba(255, 197, 46, 0.4);\n}\n\n/* Thin subtle golden vertical divider */\n.wall-divider {\n  width: 1.5px;\n  height: clamp(32px, 2.8vw, 40px);\n  background: linear-gradient(\n    180deg,\n    transparent 0%,\n    rgba(255, 197, 46, 0.85) 25%,\n    rgba(255, 197, 46, 0.85) 75%,\n    transparent 100%\n  );\n  box-shadow: 0 0 5px rgba(255, 197, 46, 0.45);\n  flex-shrink: 0;\n  margin-top: -6px; /* Aligns with numeral visual midline */\n}\n\n/* Mobile specific responsive sizing */\n@media (max-width: 640px) {\n  .wall-countdown-track {\n    gap: 0.28rem;\n  }\n  .wall-unit {\n    min-width: 32px;\n  }\n  .wall-numeral {\n    font-size: 1.35rem;\n  }\n  .wall-label {\n    font-size: 0.44rem;\n    letter-spacing: 0.1em;\n    margin-top: 0.18rem;\n  }\n  .wall-divider {\n    height: 18px;\n    margin-top: -3px;\n  }\n  .botanical-ornament {\n    width: 12px;\n    height: 24px;\n    margin: 0;\n  }\n}\n\n/* ==============================================================================\n   FIREWORKS CANVAS\n   Transparent HTML5 Canvas layer, bursts in central & right open sky\n   ============================================================================== */\n.fireworks-canvas {\n  position: fixed;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 20;\n  pointer-events: none;\n}\n\n/* ==============================================================================\n   CELEBRATION FIREWORKS CANVAS — \"HAPPY BIRTHDAY\" IN THE SKY\n   ============================================================================== */\n.birthday-celebration-canvas {\n  position: fixed;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 45;\n  pointer-events: none;\n}\n\n/* ==============================================================================\n   HEART BUTTON — FLOATS NEAR RIGHT EDGE OF SKY\n   - Small circular button with glowing pink halo & white heart\n   - Elegant slow lantern float near right edge of viewport\n   - Stays above fireworks layer\n   - Zero cards, zero background panels, zero oversized labels\n   ============================================================================== */\n.heart-sky-anchor {\n  position: fixed;\n  top: 32%;\n  right: 7vw;\n  z-index: 60;\n  pointer-events: auto;\n  animation: slowLanternFloat 5.5s infinite ease-in-out;\n}\n\n@media (max-width: 640px) {\n  .heart-sky-anchor {\n    top: 28%;\n    right: 6vw;\n  }\n}\n\n/* Elegant lantern float: gentle vertical floating with subtle horizontal sway */\n@keyframes slowLanternFloat {\n  0%, 100% {\n    transform: translate3d(0, 0, 0);\n  }\n  50% {\n    transform: translate3d(-6px, -14px, 0);\n  }\n}\n\n/* ==============================================================================\n   REDESIGNED GLOSSY ORB HEART BUTTON (With Golden Orbit Ring & Concentric Ripples)\n   Matches Reference: media_1794939937844_099ddf68.jpg\n   ============================================================================== */\n.wall-heart-button {\n  position: relative;\n  width: 72px;\n  height: 72px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  border: none !important;\n  background: transparent !important;\n  outline: none !important;\n  box-shadow: none !important;\n  -webkit-tap-highlight-color: transparent !important;\n  user-select: none;\n  -webkit-user-select: none;\n  cursor: pointer;\n  animation: heartOrbEntrance 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;\n  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.3s ease;\n  touch-action: manipulation;\n}\n\n.wall-heart-button:focus,\n.wall-heart-button:active,\n.wall-heart-button:focus-visible {\n  outline: none !important;\n  border: none !important;\n  box-shadow: none !important;\n  background: transparent !important;\n}\n\n@keyframes heartOrbEntrance {\n  0% {\n    transform: scale(0);\n    opacity: 0;\n  }\n  70% {\n    transform: scale(1.15);\n    opacity: 1;\n  }\n  100% {\n    transform: scale(1);\n    opacity: 1;\n  }\n}\n\n/* Hover state: slight lift and intensified glow */\n.wall-heart-button:hover:not(:disabled) {\n  transform: scale(1.08);\n  filter: drop-shadow(0 0 25px rgba(244, 63, 94, 0.95)) drop-shadow(0 0 35px rgba(251, 191, 36, 0.85));\n}\n\n.wall-heart-button:active:not(:disabled) {\n  transform: scale(0.96);\n}\n\n/* 1. Concentric Translucent Expanding Ripple Rings Behind Button */\n.heart-expanding-rings {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  pointer-events: none;\n  z-index: 1;\n}\n\n.ring-pulse {\n  position: absolute;\n  border-radius: 50%;\n  border: 1px solid rgba(244, 63, 94, 0.35);\n  box-shadow: 0 0 10px rgba(244, 63, 94, 0.2), inset 0 0 10px rgba(244, 63, 94, 0.15);\n  animation: ringsBreathing 3.6s infinite ease-in-out;\n}\n\n.ring-pulse.ring-1 {\n  width: 96px;\n  height: 96px;\n  border-color: rgba(244, 63, 94, 0.42);\n  animation-delay: 0s;\n}\n\n.ring-pulse.ring-2 {\n  width: 132px;\n  height: 132px;\n  border-color: rgba(244, 63, 94, 0.28);\n  animation-delay: 0.6s;\n}\n\n.ring-pulse.ring-3 {\n  width: 172px;\n  height: 172px;\n  border-color: rgba(244, 63, 94, 0.16);\n  animation-delay: 1.2s;\n}\n\n@keyframes ringsBreathing {\n  0%, 100% {\n    transform: scale(0.96);\n    opacity: 0.35;\n  }\n  50% {\n    transform: scale(1.04);\n    opacity: 0.85;\n  }\n}\n\n/* 2. Soft Pink-Red Ambient Outer Glow */\n.heart-outer-glow {\n  position: absolute;\n  inset: -12px;\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(244, 63, 94, 0.6) 0%, rgba(225, 29, 72, 0.3) 45%, transparent 75%);\n  animation: outerGlowPulse 2.8s infinite ease-in-out;\n  pointer-events: none;\n  z-index: 2;\n}\n\n@keyframes outerGlowPulse {\n  0%, 100% {\n    transform: scale(0.94);\n    opacity: 0.55;\n  }\n  50% {\n    transform: scale(1.12);\n    opacity: 0.9;\n  }\n}\n\n/* 3. Glowing Golden Orbit Ring Passing Around the Orb */\n.heart-orbit-wrapper {\n  position: absolute;\n  width: 120px;\n  height: 60px;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  pointer-events: none;\n  z-index: 5;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.heart-orbit-svg {\n  width: 100%;\n  height: 100%;\n  overflow: visible;\n  filter: drop-shadow(0 0 6px rgba(251, 191, 36, 0.95)) drop-shadow(0 0 14px rgba(245, 158, 11, 0.8));\n  animation: orbitShimmer 3s infinite ease-in-out;\n}\n\n@keyframes orbitShimmer {\n  0%, 100% {\n    filter: drop-shadow(0 0 6px rgba(251, 191, 36, 0.95)) drop-shadow(0 0 12px rgba(245, 158, 11, 0.75));\n    opacity: 0.92;\n  }\n  50% {\n    filter: drop-shadow(0 0 10px rgba(254, 240, 138, 1)) drop-shadow(0 0 20px rgba(251, 191, 36, 0.95));\n    opacity: 1;\n  }\n}\n\n/* 4-Point Golden Star Sparkle Glint at Orbit Intersection */\n.orbit-glint-star {\n  position: absolute;\n  top: 1px;\n  right: 17px;\n  width: 22px;\n  height: 22px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  filter: drop-shadow(0 0 8px #fef08a) drop-shadow(0 0 16px #fbbf24);\n  animation: starTwinkleGlint 2.2s infinite ease-in-out;\n  pointer-events: none;\n}\n\n@keyframes starTwinkleGlint {\n  0%, 100% {\n    transform: scale(0.85) rotate(0deg);\n    opacity: 0.75;\n  }\n  50% {\n    transform: scale(1.25) rotate(15deg);\n    opacity: 1;\n  }\n}\n\n/* Micro Warm Floating Particles along Orbit */\n.orbit-micro-particle {\n  position: absolute;\n  border-radius: 50%;\n  pointer-events: none;\n  background: #fef08a;\n  box-shadow: 0 0 6px #fbbf24, 0 0 12px rgba(251, 191, 36, 0.8);\n}\n\n.orbit-micro-particle.mp1 {\n  width: 4px;\n  height: 4px;\n  bottom: 8px;\n  left: 10px;\n  animation: particleFloat 2.6s infinite ease-in-out;\n}\n\n.orbit-micro-particle.mp2 {\n  width: 3px;\n  height: 3px;\n  top: 10px;\n  left: 20px;\n  animation: particleFloat 3.2s infinite ease-in-out 0.8s;\n}\n\n.orbit-micro-particle.mp3 {\n  width: 3.5px;\n  height: 3.5px;\n  bottom: 12px;\n  right: 18px;\n  animation: particleFloat 2.8s infinite ease-in-out 1.5s;\n}\n\n@keyframes particleFloat {\n  0%, 100% {\n    transform: translate(0, 0) scale(0.8);\n    opacity: 0.4;\n  }\n  50% {\n    transform: translate(-3px, -4px) scale(1.2);\n    opacity: 0.95;\n  }\n}\n\n/* 4. Glossy Pink & Rose-Red Glass Orb Core */\n.heart-orb-core {\n  position: relative;\n  width: 66px;\n  height: 66px;\n  border-radius: 50%;\n  background: radial-gradient(circle at 35% 30%, #ff527b 0%, #e11d48 42%, #be123c 75%, #881337 100%);\n  border: 2.5px solid rgba(254, 240, 138, 0.95);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow:\n    0 8px 24px rgba(0, 0, 0, 0.5),\n    0 0 18px rgba(251, 191, 36, 0.9),\n    0 0 32px rgba(244, 63, 94, 0.75),\n    inset 0 0 12px rgba(255, 180, 205, 0.55),\n    inset 0 2px 4px rgba(255, 255, 255, 0.6);\n  z-index: 4;\n  overflow: hidden;\n  box-sizing: border-box;\n}\n\n/* Curved Glossy Glass Crescent Glare (Upper Edge) */\n.heart-orb-glass-glare {\n  position: absolute;\n  top: 3px;\n  left: 10px;\n  right: 10px;\n  height: 25px;\n  border-radius: 50% 50% 45% 45% / 60% 60% 30% 30%;\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.3) 40%, transparent 85%);\n  pointer-events: none;\n  z-index: 6;\n}\n\n/* Clean, Bright Ivory-White Heart in Center */\n.white-heart-icon {\n  width: 32px;\n  height: 32px;\n  color: #ffffff;\n  filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.9)) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.35));\n  animation: heartOrbPulse 2.4s infinite ease-in-out;\n  position: relative;\n  z-index: 5;\n}\n\n@keyframes heartOrbPulse {\n  0%, 100% {\n    transform: scale(1);\n  }\n  15% {\n    transform: scale(1.12);\n  }\n  30% {\n    transform: scale(1);\n  }\n  45% {\n    transform: scale(1.06);\n  }\n}\n\n/* 5. Interactive Click Effects */\n/* Click Expanding Ripple */\n.heart-click-ripple {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 60px;\n  height: 60px;\n  border-radius: 50%;\n  border: 2px solid #fef08a;\n  box-shadow: 0 0 20px #fbbf24, 0 0 40px rgba(244, 63, 94, 0.8);\n  pointer-events: none;\n  z-index: 10;\n  animation: clickRippleExpand 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n@keyframes clickRippleExpand {\n  0% {\n    transform: translate(-50%, -50%) scale(0.8);\n    opacity: 1;\n  }\n  100% {\n    transform: translate(-50%, -50%) scale(2.6);\n    opacity: 0;\n  }\n}\n\n/* Click Burst Micro-Hearts */\n.heart-burst-particle {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  color: var(--color, #fbbf24);\n  font-size: var(--size, 10px);\n  pointer-events: none;\n  z-index: 12;\n  line-height: 1;\n  filter: drop-shadow(0 0 6px currentColor);\n  animation: burstParticleFly 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n@keyframes burstParticleFly {\n  0% {\n    transform: translate(-50%, -50%) rotate(var(--angle)) translateY(0) scale(0.6);\n    opacity: 1;\n  }\n  70% {\n    opacity: 0.9;\n  }\n  100% {\n    transform: translate(-50%, -50%) rotate(var(--angle)) translateY(calc(-1 * var(--dist))) scale(1.2);\n    opacity: 0;\n  }\n}\n\n/* Click Tactile State & Luminous Bloom */\n.wall-heart-button.is-clicked {\n  animation: clickBloom 0.55s ease-out forwards;\n}\n\n@keyframes clickBloom {\n  0% {\n    transform: scale(1);\n    filter: brightness(1);\n  }\n  30% {\n    transform: scale(1.22);\n    filter: brightness(1.6) drop-shadow(0 0 35px rgba(251, 191, 36, 1)) drop-shadow(0 0 50px rgba(244, 63, 94, 0.95));\n  }\n  100% {\n    transform: scale(1);\n    filter: brightness(1);\n  }\n}\n\n/* Celebration Stages Integration */\n.wall-heart-button.heart-celebrating {\n  animation: heartOrbCelebrating 2.4s infinite ease-in-out;\n  cursor: default;\n}\n\n@keyframes heartOrbCelebrating {\n  0%, 100% {\n    transform: scale(1);\n    filter: drop-shadow(0 0 20px rgba(244, 63, 94, 0.8)) drop-shadow(0 0 28px rgba(251, 191, 36, 0.6));\n  }\n  50% {\n    transform: scale(1.07);\n    filter: drop-shadow(0 0 32px rgba(244, 63, 94, 1)) drop-shadow(0 0 42px rgba(251, 191, 36, 0.9));\n  }\n}\n\n.wall-heart-button.heart-holding-ready {\n  animation: heartOrbHoldingReady 1.6s infinite cubic-bezier(0.4, 0, 0.2, 1);\n  cursor: pointer;\n}\n\n@keyframes heartOrbHoldingReady {\n  0%, 100% {\n    transform: scale(1);\n    filter: drop-shadow(0 0 20px rgba(244, 63, 94, 0.85)) drop-shadow(0 0 30px rgba(251, 191, 36, 0.7));\n  }\n  16% {\n    transform: scale(1.2);\n    filter: drop-shadow(0 0 38px rgba(244, 63, 94, 1)) drop-shadow(0 0 50px rgba(251, 191, 36, 1));\n  }\n  30% {\n    transform: scale(1.05);\n  }\n  44% {\n    transform: scale(1.14);\n    filter: drop-shadow(0 0 34px rgba(244, 63, 94, 0.95)) drop-shadow(0 0 44px rgba(251, 191, 36, 0.9));\n  }\n}\n\n.wall-heart-button.heart-bursting {\n  pointer-events: none;\n  animation: heartBurstClick 0.65s cubic-bezier(0.2, 0.9, 0.3, 1) forwards !important;\n}\n\n@keyframes heartBurstClick {\n  0% {\n    transform: scale(1);\n    filter: brightness(1) drop-shadow(0 0 15px rgba(244, 63, 94, 0.7));\n  }\n  40% {\n    transform: scale(1.4);\n    filter: brightness(2) drop-shadow(0 0 35px rgba(251, 191, 36, 0.95)) drop-shadow(0 0 50px rgba(244, 63, 94, 0.9));\n    opacity: 1;\n  }\n  75% {\n    transform: scale(1.75);\n    opacity: 0.6;\n    filter: brightness(2.2);\n  }\n  100% {\n    transform: scale(2.2);\n    opacity: 0;\n  }\n}\n\n@media (max-width: 640px) {\n  .wall-heart-button {\n    width: 62px;\n    height: 62px;\n  }\n  .heart-orb-core {\n    width: 58px;\n    height: 58px;\n  }\n  .white-heart-icon {\n    width: 28px;\n    height: 28px;\n  }\n  .heart-orbit-wrapper {\n    width: 104px;\n    height: 52px;\n  }\n  .ring-pulse.ring-1 { width: 82px; height: 82px; }\n  .ring-pulse.ring-2 { width: 112px; height: 112px; }\n  .ring-pulse.ring-3 { width: 145px; height: 145px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .wall-heart-button,\n  .heart-outer-glow,\n  .ring-pulse,\n  .heart-orbit-svg,\n  .orbit-glint-star,\n  .orbit-micro-particle,\n  .white-heart-icon {\n    animation: none !important;\n  }\n}\n\n/* ==============================================================================\n   MAIN BIRTHDAY SECTION (STAGE 3) — MINIMAL & CINEMATIC REDESIGN\n   ============================================================================== */\n.main-page-root {\n  position: relative;\n  min-height: 100vh;\n  width: 100vw;\n  overflow-x: hidden;\n  overflow-y: auto;\n  background-color: var(--color-bg-dark);\n  animation: mainPageFadeIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n@keyframes mainPageFadeIn {\n  from {\n    opacity: 0;\n    transform: scale(0.99);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n.main-background-container {\n  position: fixed;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 0;\n  pointer-events: none;\n}\n\n.main-background-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center bottom;\n  display: block;\n}\n\n/* Cinematic Scenery Darkening Overlay:\n * Applies ~22% darkening to scenery (sky, distant landscape, mountains, terrace)\n * while preserving 100% original brightness and warm golden glow on all visible light sources:\n * - Lower-right lamp & surrounding ambient glow (completely outside the darkening effect)\n * - Lower-left lantern & ground reflection\n * - Left hanging bulbs & vine fairy lights\n * Scales and aligns responsively in lockstep with the background image (center bottom / cover).\n */\n.main-background-container::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  background-image: url('/scenery-darkening-mask.svg');\n  background-position: center bottom;\n  background-size: cover;\n  background-repeat: no-repeat;\n}\n\n/* Main Content Two-Column Grid */\n.main-content-layout {\n  position: relative;\n  left: 32px; /* Shifts layout ~32px to the right on desktop */\n  z-index: 10;\n  width: 100%;\n  max-width: 1080px; /* ~7% smaller overall container width */\n  margin: 0 auto;\n  padding: clamp(1.85rem, 3.6vw, 3.25rem) clamp(1.25rem, 3vw, 2.25rem);\n  display: grid;\n  grid-template-columns: minmax(0, 66%) minmax(0, 28%);\n  gap: clamp(1.25rem, 2.5vw, 2.35rem);\n  align-items: start;\n}\n\n/* ==============================================================================\n   FULLSCREEN MODE: VERTICAL POSITIONING FOR MAIN BIRTHDAY PAGE\n   - Moves the complete main content group 45–55px downward (~5.5–6vh) in fullscreen mode only\n   - Preserves all horizontal positions, sizes, alignments, spacing, and proportions\n   - Strictly active ONLY during fullscreen; automatically restores normal layout on exit\n   - Prevents scrollbar appearance in fullscreen mode\n   ============================================================================== */\n:fullscreen .main-page-root,\n:-webkit-full-screen .main-page-root,\n:-moz-full-screen .main-page-root,\n:-ms-fullscreen .main-page-root,\n.main-page-root.is-fullscreen {\n  height: 100vh;\n  height: 100dvh;\n  min-height: 100vh;\n  min-height: 100dvh;\n  max-height: 100vh;\n  max-height: 100dvh;\n  overflow: hidden !important;\n  overflow-y: hidden !important;\n}\n\n:fullscreen .main-content-layout,\n:-webkit-full-screen .main-content-layout,\n:-moz-full-screen .main-content-layout,\n:-ms-fullscreen .main-content-layout,\n.main-page-root.is-fullscreen .main-content-layout {\n  padding-top: calc(clamp(1.85rem, 3.6vw, 3.25rem) + clamp(48px, 5.5vh, 54px));\n}\n\n@media all and (display-mode: fullscreen) {\n  .main-page-root {\n    height: 100vh;\n    height: 100dvh;\n    min-height: 100vh;\n    min-height: 100dvh;\n    max-height: 100vh;\n    max-height: 100dvh;\n    overflow: hidden !important;\n    overflow-y: hidden !important;\n  }\n\n  .main-content-layout {\n    padding-top: calc(clamp(1.85rem, 3.6vw, 3.25rem) + clamp(48px, 5.5vh, 54px));\n  }\n}\n\n/* ================= LEFT COLUMN ================= */\n.main-left-column {\n  display: flex;\n  flex-direction: column;\n}\n\n/* Minimal Title at Top Left */\n.minimal-page-title {\n  font-family: var(--font-serif-display), serif;\n  font-size: clamp(1.72rem, 2.7vw, 2.45rem);\n  font-weight: 700;\n  color: #fffdfa;\n  letter-spacing: 0.025em;\n  line-height: 1.22;\n  margin-bottom: 1.1rem;\n  white-space: nowrap;\n  text-shadow:\n    0 2px 10px rgba(0, 0, 0, 0.65),\n    0 0 20px rgba(212, 175, 55, 0.25);\n}\n\n/* Dark Frosted Glass Message Card with Layered Luminous Golden Edge */\n.minimal-message-card {\n  position: relative;\n  background: rgba(65, 38, 65, 0.58);\n  backdrop-filter: blur(18px);\n  -webkit-backdrop-filter: blur(18px);\n  border: 1px solid rgba(255, 228, 168, 0.75);\n  border-radius: 1.2rem;\n  padding: clamp(1.35rem, 2.2vw, 2rem);\n  box-shadow:\n    /* Deep card elevation shadow */\n    0 22px 50px rgba(0, 0, 0, 0.58),\n    /* Bright concentrated golden highlight directly along the edge */\n    0 0 3px rgba(255, 235, 180, 0.68),\n    /* Soft golden glow spreading outward from the border */\n    0 0 12px rgba(255, 192, 95, 0.42),\n    /* Luminous warm ambient aura */\n    0 0 28px rgba(245, 172, 75, 0.28),\n    /* Gentle warm light bloom around corners and edges */\n    0 0 55px rgba(230, 150, 55, 0.15),\n    /* Subtle inner edge illumination */\n    inset 0 1px 1.5px rgba(255, 245, 220, 0.70),\n    inset 0 0 14px rgba(255, 195, 95, 0.16),\n    inset 0 0 28px rgba(232, 160, 60, 0.08);\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n/* Subtle corner & edge light bloom pseudo-element for natural variations in intensity */\n.minimal-message-card::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  background:\n    radial-gradient(\n      circle at 18% 0%,\n      rgba(255, 238, 195, 0.18) 0%,\n      transparent 55%\n    ),\n    radial-gradient(\n      circle at 85% 100%,\n      rgba(255, 205, 115, 0.12) 0%,\n      transparent 50%\n    );\n  box-shadow:\n    inset 0 1.5px 2px rgba(255, 245, 220, 0.65),\n    inset 1.5px 0 2px rgba(255, 230, 175, 0.40),\n    inset -1px -1px 2px rgba(230, 175, 90, 0.30);\n  z-index: 0;\n}\n\n@supports not (backdrop-filter: blur(18px)) {\n  .minimal-message-card {\n    background: rgba(48, 28, 48, 0.88);\n  }\n}\n\n/* Vertically Scrollable Content Area with Visually Hidden Scrollbar */\n.minimal-message-scroll-viewport {\n  position: relative;\n  z-index: 1;\n  max-height: clamp(260px, 44vh, 385px);\n  overflow-y: auto;\n  overflow-x: hidden;\n  touch-action: pan-y;\n  -webkit-overflow-scrolling: touch;\n  overscroll-behavior: contain;\n  outline: none;\n  display: flex;\n  flex-direction: column;\n  gap: 1.05rem;\n  padding-right: 0.85rem;\n  padding-bottom: 1.5rem;\n\n  /* Visually hidden scrollbar cross-browser */\n  scrollbar-width: none; /* Firefox */\n  -ms-overflow-style: none; /* IE and Edge */\n}\n\n.minimal-message-scroll-viewport::-webkit-scrollbar {\n  display: none; /* Chrome, Safari, Opera */\n  width: 0;\n  height: 0;\n}\n\n.minimal-message-scroll-viewport:focus-visible {\n  outline: 1.5px solid rgba(232, 188, 117, 0.6);\n  outline-offset: 3px;\n  border-radius: 0.5rem;\n}\n\n/* ==============================================================================\n   TINY FLOATING SCROLL INDICATOR\n   - No track, no line, no background bar\n   - Only a slim rounded glowing thumb moving vertically with scroll progress\n   - Subtle champagne gold / warm ivory glow\n   ============================================================================== */\n.message-scroll-indicator-track {\n  position: absolute;\n  top: clamp(1.35rem, 2.2vw, 2rem);\n  bottom: clamp(1.35rem, 2.2vw, 2rem);\n  right: clamp(7px, 1vw, 10px);\n  width: 3.5px;\n  pointer-events: none;\n  z-index: 10;\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n\n.message-scroll-indicator-thumb {\n  width: 3.5px;\n  height: 24px;\n  border-radius: 9999px;\n  background: linear-gradient(\n    180deg,\n    rgba(255, 245, 225, 0.92) 0%,\n    rgba(235, 192, 120, 0.88) 100%\n  );\n  box-shadow:\n    0 0 5px rgba(255, 225, 145, 0.70),\n    0 0 10px rgba(245, 185, 90, 0.40);\n  opacity: 0.75;\n  transition: transform 0.05s ease-out;\n  will-change: transform;\n}\n\n/* Salutation */\n.minimal-salutation {\n  font-family: var(--font-serif-card), serif;\n  font-size: clamp(1.35rem, 1.75vw, 1.62rem);\n  font-weight: 600;\n  color: #FFF4E0;\n  letter-spacing: 0.015em;\n  line-height: 1.3;\n  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.55);\n}\n\n/* Body Paragraphs */\n.minimal-paragraph {\n  font-family: var(--font-serif-card), serif;\n  font-size: clamp(0.98rem, 1.1vw, 1.1rem);\n  line-height: 1.76;\n  color: #F8EFE2;\n  font-weight: 400;\n  letter-spacing: 0.01em;\n  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);\n}\n\n/* Sign-off & Sender */\n.minimal-signoff {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  margin-top: 0.75rem;\n}\n\n.minimal-closing {\n  font-family: var(--font-serif-card), serif;\n  font-size: 1.05rem;\n  font-style: italic;\n  color: #E6D2B4;\n  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);\n}\n\n.minimal-sender {\n  font-family: var(--font-serif-card), serif;\n  font-size: 1.18rem;\n  font-weight: 600;\n  color: #FFF4E0;\n  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.55);\n}\n\n/* ================= RIGHT COLUMN ================= */\n.main-right-column {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  width: 100%;\n}\n\n/* Portrait Secret Image Card */\n.minimal-image-card {\n  position: relative;\n  width: 88%;\n  margin: 16% auto 12% auto; /* 12% bottom margin preserves exact vertical position of the button while revealing sunset in the gap */\n  background: rgba(255, 252, 246, 0.94);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border: 1px solid rgba(224, 195, 140, 0.42);\n  border-radius: 1.15rem;\n  padding: 0.55rem;\n  cursor: pointer;\n  box-shadow:\n    0 18px 40px rgba(0, 0, 0, 0.35),\n    0 0 25px rgba(212, 175, 55, 0.1),\n    inset 0 1px 2px rgba(255, 255, 255, 0.7);\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n.minimal-image-card:hover {\n  transform: translateY(-3px);\n  box-shadow:\n    0 22px 46px rgba(0, 0, 0, 0.4),\n    0 0 30px rgba(212, 175, 55, 0.18);\n}\n\n.minimal-image-frame {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 5 / 6; /* Reduced height by 10% (from 3/4 to 5/6) to reveal setting sun */\n  border-radius: 0.9rem;\n  overflow: hidden;\n  background: #181422;\n}\n\n.minimal-portrait-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center;\n  display: block;\n  transition: transform 0.5s ease;\n}\n\n.minimal-image-card:hover .minimal-portrait-image {\n  transform: scale(1.025);\n}\n\n/* Link Box Immediately Below Image Card */\n.minimal-link-container {\n  width: 100%;\n}\n\n/* ==============================================================================\n   MINIMAL NEON \"CLIP FOR YOU\" BUTTON (Option 5 Reference Design)\n   - 100% pure HTML & CSS (zero images, zero external icons, zero SVG assets)\n   - Refined horizontal pill-shaped button\n   - Dark plum/purple frosted glass with subtle transparency\n   - Thin, luminous glowing neon-pink outline & soft pink-purple outer glow\n   - Smooth, fully rounded corners (pill shape)\n   - Left circular neon play icon with clean CSS triangle\n   - Thin vertical divider\n   - Elegant italic serif typography (\"Clip for You\") with warm ivory/pink text glow\n   - Right glowing double-chevron (»)\n   ============================================================================== */\n\n.minimal-link-box {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n  box-sizing: border-box;\n  padding: 0 1.25rem 0 0.95rem;\n  height: 50px;\n  background: linear-gradient(135deg, rgba(38, 14, 35, 0.78) 0%, rgba(20, 8, 22, 0.84) 100%);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border: 1.5px solid rgba(255, 105, 180, 0.88);\n  border-radius: 9999px;\n  box-shadow:\n    0 0 10px rgba(255, 99, 177, 0.45),\n    0 0 24px rgba(233, 30, 130, 0.28),\n    0 10px 28px rgba(0, 0, 0, 0.42),\n    inset 0 0 10px rgba(255, 105, 180, 0.12);\n  text-decoration: none;\n  cursor: pointer;\n  outline: none;\n  position: relative;\n  overflow: hidden;\n  transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease, background 0.25s ease;\n}\n\n.minimal-link-box:hover {\n  border-color: #ff85c4;\n  background: linear-gradient(135deg, rgba(48, 18, 44, 0.84) 0%, rgba(26, 10, 28, 0.90) 100%);\n  transform: translateY(-2px);\n  box-shadow:\n    0 0 14px rgba(255, 105, 180, 0.65),\n    0 0 32px rgba(233, 30, 130, 0.42),\n    0 14px 34px rgba(0, 0, 0, 0.48),\n    inset 0 0 14px rgba(255, 105, 180, 0.22);\n}\n\n.minimal-link-box:active {\n  transform: translateY(0) scale(0.985);\n  box-shadow:\n    0 0 8px rgba(255, 105, 180, 0.5),\n    0 0 18px rgba(233, 30, 130, 0.3),\n    0 4px 14px rgba(0, 0, 0, 0.4);\n}\n\n.minimal-link-box:focus-visible {\n  outline: 2px solid #ff69b4;\n  outline-offset: 3px;\n}\n\n.minimal-link-box.is-placeholder {\n  cursor: default;\n}\n\n/* Left Circular Neon Play Icon */\n.minimal-link-play-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  min-width: 32px;\n  border-radius: 50%;\n  border: 1.5px solid rgba(255, 255, 255, 0.92);\n  box-shadow:\n    0 0 8px rgba(255, 105, 180, 0.75),\n    inset 0 0 5px rgba(255, 105, 180, 0.45);\n  background: rgba(255, 255, 255, 0.04);\n  flex-shrink: 0;\n  transition: border-color 0.25s ease, box-shadow 0.25s ease;\n}\n\n.minimal-link-box:hover .minimal-link-play-icon {\n  border-color: #ffffff;\n  box-shadow:\n    0 0 12px rgba(255, 120, 195, 0.95),\n    inset 0 0 7px rgba(255, 105, 180, 0.65);\n}\n\n/* Pure CSS Triangle */\n.minimal-link-play-triangle {\n  display: block;\n  width: 0;\n  height: 0;\n  border-style: solid;\n  border-width: 5px 0 5px 9px;\n  border-color: transparent transparent transparent #ffffff;\n  margin-left: 2px;\n  filter: drop-shadow(0 0 3px rgba(255, 140, 195, 0.7));\n  transition: filter 0.25s ease;\n}\n\n.minimal-link-box:hover .minimal-link-play-triangle {\n  filter: drop-shadow(0 0 5px rgba(255, 160, 210, 0.95));\n}\n\n/* Thin Vertical Divider */\n.minimal-link-divider {\n  display: block;\n  width: 1px;\n  height: 24px;\n  background: linear-gradient(to bottom, transparent, rgba(255, 185, 220, 0.65) 20%, rgba(255, 185, 220, 0.65) 80%, transparent);\n  box-shadow: 0 0 4px rgba(255, 105, 180, 0.45);\n  margin: 0 14px;\n  flex-shrink: 0;\n}\n\n/* \"Clip for You\" Italic Serif Typography */\n.minimal-link-text {\n  font-family: 'Playfair Display', 'Cormorant Garamond', Georgia, serif;\n  font-style: italic;\n  font-size: clamp(1.08rem, 1.25vw, 1.22rem);\n  font-weight: 500;\n  color: #fffaf5;\n  letter-spacing: 0.02em;\n  text-transform: none;\n  white-space: nowrap;\n  flex: 1;\n  text-align: center;\n  text-shadow:\n    0 0 4px rgba(255, 255, 255, 0.8),\n    0 0 10px rgba(255, 105, 180, 0.55),\n    0 0 20px rgba(233, 30, 99, 0.35);\n  transition: color 0.25s ease, text-shadow 0.25s ease;\n}\n\n.minimal-link-box:hover .minimal-link-text {\n  color: #ffffff;\n  text-shadow:\n    0 0 6px rgba(255, 255, 255, 0.95),\n    0 0 14px rgba(255, 120, 195, 0.8),\n    0 0 24px rgba(233, 30, 99, 0.5);\n}\n\n/* Right Double-Chevron (») */\n.minimal-link-chevron {\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Georgia, serif;\n  font-size: 1.35rem;\n  line-height: 1;\n  font-weight: 600;\n  color: #ffffff;\n  text-shadow:\n    0 0 4px rgba(255, 255, 255, 0.8),\n    0 0 9px rgba(255, 105, 180, 0.7),\n    0 0 16px rgba(233, 30, 99, 0.45);\n  margin-left: 12px;\n  user-select: none;\n  flex-shrink: 0;\n  transition: transform 0.25s ease, text-shadow 0.25s ease;\n}\n\n.minimal-link-box:hover .minimal-link-chevron {\n  transform: translateX(2px);\n  text-shadow:\n    0 0 6px rgba(255, 255, 255, 0.95),\n    0 0 14px rgba(255, 120, 195, 0.9),\n    0 0 22px rgba(233, 30, 99, 0.6);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .minimal-link-box,\n  .minimal-link-box:hover,\n  .minimal-link-box:active,\n  .minimal-link-chevron {\n    transform: none !important;\n    transition: none !important;\n  }\n}\n\n/* ================= MOBILE RESPONSIVENESS ================= */\n@media (max-width: 860px) {\n  .main-content-layout {\n    left: 0;\n    grid-template-columns: 1fr;\n    gap: 1.75rem;\n  }\n\n  .minimal-page-title {\n    white-space: normal;\n    text-align: left;\n  }\n\n  .main-right-column {\n    max-width: 330px;\n    margin: 0 auto;\n  }\n\n  :fullscreen .main-content-layout,\n  :-webkit-full-screen .main-content-layout,\n  :-moz-full-screen .main-content-layout,\n  :-ms-fullscreen .main-content-layout,\n  .main-page-root.is-fullscreen .main-content-layout {\n    padding-top: calc(1.85rem + clamp(45px, 5.5vh, 52px));\n  }\n\n  @media all and (display-mode: fullscreen) {\n    .main-content-layout {\n      padding-top: calc(1.85rem + clamp(45px, 5.5vh, 52px));\n    }\n  }\n}\n\n\n/* ==============================================================================\n   TOP-RIGHT CONTROLS CLUSTER (SHARED FLEX CONTAINER)\n   Clean horizontal row holding See This View, Click & See, and Test Helper\n   with guaranteed spacing, zero overlapping, and responsive wrapping.\n   ============================================================================== */\n.top-right-controls-cluster {\n  position: fixed;\n  top: 1rem;\n  right: 1rem;\n  z-index: 120;\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 8px;\n  flex-wrap: wrap;\n  max-width: calc(100vw - 2rem);\n  pointer-events: none;\n}\n\n.top-right-controls-cluster > * {\n  pointer-events: auto;\n}\n\n/* ==============================================================================\n   TELEPORT_24H_NAV: TELEPORT DROPDOWN STYLES\n   ============================================================================== */\n.teleport-nav-container {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  z-index: 125;\n}\n\n.teleport-nav-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  min-height: 38px;\n  background: rgba(18, 24, 38, 0.78);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid rgba(235, 200, 140, 0.45);\n  border-radius: 9999px;\n  padding: 8px 14px;\n  font-family: var(--font-sans);\n  font-size: 0.8rem;\n  font-weight: 500;\n  color: #fff6e5;\n  cursor: pointer;\n  transition: all 0.25s ease;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);\n  user-select: none;\n}\n\n.teleport-nav-btn:hover,\n.teleport-nav-btn.is-active {\n  background: rgba(28, 36, 54, 0.9);\n  border-color: rgba(255, 225, 160, 0.85);\n  color: #ffffff;\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45), 0 0 16px rgba(235, 195, 130, 0.35);\n  transform: translateY(-1px);\n}\n\n.teleport-chevron {\n  transition: transform 0.25s ease;\n  color: rgba(255, 228, 168, 0.85);\n}\n\n.teleport-chevron.rotate-180 {\n  transform: rotate(180deg);\n}\n\n/* Dropdown Menu Panel */\n.teleport-dropdown-panel {\n  position: absolute;\n  top: calc(100% + 8px);\n  right: 0;\n  min-width: 200px;\n  background: rgba(18, 14, 26, 0.94);\n  backdrop-filter: blur(18px);\n  -webkit-backdrop-filter: blur(18px);\n  border: 1.5px solid rgba(255, 228, 168, 0.65);\n  border-radius: 16px;\n  padding: 6px;\n  box-shadow:\n    0 12px 36px rgba(0, 0, 0, 0.65),\n    0 0 20px rgba(255, 215, 120, 0.22);\n  z-index: 150;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  animation: teleportDropdownFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n@keyframes teleportDropdownFadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(-6px) scale(0.97);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n.teleport-dropdown-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n  padding: 8px 12px;\n  background: 