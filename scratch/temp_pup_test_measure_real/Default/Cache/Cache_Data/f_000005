t-child {\n  border-bottom: none;\n  padding-bottom: 4px;\n}\n\n.mobile-info-item:first-child {\n  padding-top: 4px;\n}\n\n.mobile-info-item-badge {\n  position: relative;\n  flex-shrink: 0;\n  width: 46px;\n  height: 46px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(135deg, rgba(244, 114, 182, 0.3) 0%, rgba(251, 191, 36, 0.22) 100%);\n  border: 1px solid rgba(255, 215, 170, 0.55);\n  box-shadow:\n    0 4px 14px rgba(0, 0, 0, 0.4),\n    0 0 14px rgba(251, 191, 36, 0.3);\n}\n\n.mobile-info-icon-glow {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #fff6e5;\n  filter: drop-shadow(0 0 6px rgba(255, 220, 150, 0.7));\n}\n\n.mobile-info-step-number {\n  position: absolute;\n  bottom: -2px;\n  right: -2px;\n  width: 17px;\n  height: 17px;\n  border-radius: 50%;\n  background: #fbbf24;\n  color: #1c0a18;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  font-size: 0.68rem;\n  font-weight: 800;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);\n}\n\n.mobile-info-item-text {\n  flex: 1;\n}\n\n.mobile-info-item-title {\n  font-family: var(--font-serif-display), 'Cinzel', Georgia, serif;\n  font-size: 0.98rem;\n  font-weight: 600;\n  color: #fff9f0;\n  margin: 0 0 3px 0;\n  letter-spacing: 0.02em;\n}\n\n.mobile-info-item-desc {\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  font-size: 0.82rem;\n  color: rgba(255, 235, 225, 0.88);\n  margin: 0;\n  line-height: 1.38;\n}\n\n.mobile-info-footer {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  color: #fed7aa;\n  font-family: var(--font-serif), Georgia, serif;\n  font-size: 0.92rem;\n  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);\n}\n\n.mobile-footer-heart {\n  color: #f472b6;\n  font-size: 0.85rem;\n}\n\n.mobile-info-bypass-btn {\n  margin-top: 16px;\n  background: transparent;\n  border: none;\n  color: rgba(255, 215, 180, 0.65);\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  font-size: 0.76rem;\n  text-decoration: underline;\n  cursor: pointer;\n  padding: 6px 12px;\n  transition: color 0.2s ease;\n}\n\n.mobile-info-bypass-btn:hover {\n  color: #fff;\n}\n\n/* ==============================================================================\n   GALLERY VIDEO PLAYER (Sad & Happy Galleries Mixed Media)\n   - Zero native browser controls\n   - Preserves original aspect ratio\n   - Only 2 custom controls: Play/Pause and Volume\n   ============================================================================== */\n.gallery-video-container {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  flex: 1 1 auto;\n  max-height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  border-radius: clamp(10px, 1.4vw, 13px);\n  background: rgba(5, 5, 10, 0.6);\n  cursor: pointer;\n  user-select: none;\n}\n\n.gallery-video-element {\n  width: 100%;\n  height: 100%;\n  max-height: 100%;\n  object-fit: contain;\n  border-radius: clamp(10px, 1.4vw, 13px);\n  display: block;\n}\n\n.gallery-video-center-overlay {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  pointer-events: none;\n  z-index: 5;\n}\n\n.gallery-video-center-play-btn {\n  pointer-events: auto;\n  width: 64px;\n  height: 64px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 1.5px solid rgba(255, 255, 255, 0.6);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);\n  transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s ease;\n  cursor: pointer;\n}\n\n.sad-video-theme .gallery-video-center-play-btn {\n  background: rgba(14, 30, 60, 0.82);\n  border-color: rgba(56, 189, 248, 0.85);\n  box-shadow: 0 0 24px rgba(56, 189, 248, 0.5), 0 8px 24px rgba(0, 0, 0, 0.7);\n  color: #38bdf8;\n}\n\n.happy-video-theme .gallery-video-center-play-btn {\n  background: rgba(48, 18, 38, 0.82);\n  border-color: rgba(251, 191, 36, 0.85);\n  box-shadow: 0 0 24px rgba(251, 191, 36, 0.5), 0 8px 24px rgba(0, 0, 0, 0.7);\n  color: #fbbf24;\n}\n\n.gallery-video-center-play-btn:hover {\n  transform: scale(1.08);\n}\n\n.gallery-video-play-icon {\n  margin-left: 4px;\n}\n\n/* Floating Custom Controls Bar (Only 2 Controls: Play/Pause and Volume) */\n.gallery-video-controls-bar {\n  position: absolute;\n  bottom: 12px;\n  left: 50%;\n  transform: translateX(-50%);\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 6px 16px;\n  border-radius: 30px;\n  backdrop-filter: blur(20px) saturate(180%);\n  -webkit-backdrop-filter: blur(20px) saturate(180%);\n  z-index: 10;\n  transition: opacity 0.3s ease, transform 0.3s ease;\n}\n\n.gallery-video-controls-bar.is-hidden {\n  opacity: 0;\n  pointer-events: none;\n  transform: translateX(-50%) translateY(8px);\n}\n\n.gallery-video-controls-bar.is-visible {\n  opacity: 1;\n  pointer-events: auto;\n  transform: translateX(-50%) translateY(0);\n}\n\n.sad-video-theme .gallery-video-controls-bar {\n  background: linear-gradient(135deg, rgba(10, 24, 48, 0.88) 0%, rgba(6, 14, 30, 0.94) 100%);\n  border: 1px solid rgba(56, 189, 248, 0.65);\n  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6), 0 0 16px rgba(56, 189, 248, 0.35);\n  color: #e0f2fe;\n}\n\n.happy-video-theme .gallery-video-controls-bar {\n  background: linear-gradient(135deg, rgba(48, 18, 38, 0.88) 0%, rgba(28, 10, 24, 0.94) 100%);\n  border: 1px solid rgba(251, 191, 36, 0.65);\n  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6), 0 0 16px rgba(251, 191, 36, 0.35);\n  color: #fffaf0;\n}\n\n.gallery-video-ctrl-btn {\n  background: transparent;\n  border: none;\n  color: inherit;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 4px;\n  border-radius: 50%;\n  transition: transform 0.15s ease, opacity 0.15s ease;\n}\n\n.gallery-video-ctrl-btn:hover {\n  transform: scale(1.12);\n  opacity: 0.9;\n}\n\n.gallery-video-ctrl-divider {\n  width: 1px;\n  height: 16px;\n  background: rgba(255, 255, 255, 0.25);\n}\n\n.gallery-video-volume-group {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.gallery-video-volume-slider {\n  width: 65px;\n  height: 4px;\n  cursor: pointer;\n}\n\n.sad-video-theme .gallery-video-volume-slider {\n  accent-color: #38bdf8;\n}\n\n.happy-video-theme .gallery-video-volume-slider {\n  accent-color: #fbbf24;\n}\n\n/* ==============================================================================\n   Q&A SECTION STYLES (MOMENTS & MEMORIES)\n   Frosted-Glass Elegance, 2x2 Options Layout, Dynamic Left/Right Message Cards\n   ============================================================================== */\n\n.qna-root {\n  position: fixed;\n  inset: 0;\n  width: 100vw;\n  height: 100vh;\n  overflow-y: auto;\n  overflow-x: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 50;\n  box-sizing: border-box;\n  background: linear-gradient(180deg, #169dfe 0%, #30583a 50%, #686915 100%);\n}\n\n.qna-background-wrapper {\n  position: fixed;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  z-index: 0;\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(180deg, #169dfe 0%, #30583a 50%, #686915 100%);\n}\n\n.qna-background-img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center;\n  display: block;\n}\n\n.qna-background-overlay {\n  display: none;\n}\n\n.qna-screen-container {\n  position: relative;\n  z-index: 10;\n  width: 100%;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 60px 24px;\n  box-sizing: border-box;\n}\n\n@keyframes qnaFadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(12px) scale(0.99);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n.qna-fade-in {\n  animation: qnaFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n/* Base Glass Card */\n.qna-glass-card {\n  background: linear-gradient(135deg, rgba(22, 30, 42, 0.62) 0%, rgba(14, 20, 30, 0.72) 100%);\n  backdrop-filter: blur(24px) saturate(160%);\n  -webkit-backdrop-filter: blur(24px) saturate(160%);\n  border: 1px solid rgba(235, 200, 140, 0.48);\n  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.38), 0 0 32px rgba(235, 195, 130, 0.22), inset 0 1px 1px rgba(255, 255, 255, 0.3);\n  border-radius: 20px;\n  color: #f8fafc;\n  box-sizing: border-box;\n}\n\n/* -----------------------------------------------------------------------------\n   SCREEN 1: CATEGORY SELECTION\n   ----------------------------------------------------------------------------- */\n.qna-categories-card {\n  max-width: 860px;\n  width: 100%;\n  padding: 48px 42px;\n  text-align: center;\n}\n\n.qna-header-section {\n  margin-bottom: 34px;\n}\n\n.qna-main-title {\n  font-family: var(--font-serif-display);\n  font-size: 2.25rem;\n  letter-spacing: 0.05em;\n  color: #fff9ed;\n  margin-bottom: 12px;\n  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.55);\n}\n\n.qna-main-subtitle {\n  font-family: var(--font-serif-card);\n  font-size: 1.2rem;\n  color: #f3e5d0;\n  font-style: italic;\n}\n\n.qna-categories-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 20px;\n}\n\n.qna-category-tile {\n  background: rgba(255, 255, 255, 0.08);\n  border: 1px solid rgba(235, 200, 140, 0.36);\n  border-radius: 18px;\n  padding: 28px 24px;\n  cursor: pointer;\n  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 12px;\n  color: #f8fafc;\n  text-align: center;\n}\n\n.qna-category-tile:hover {\n  transform: translateY(-4px);\n  background: rgba(255, 255, 255, 0.16);\n  border-color: rgba(250, 220, 160, 0.85);\n  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.32), 0 0 24px rgba(235, 195, 130, 0.36);\n}\n\n.qna-category-emoji {\n  font-size: 2.4rem;\n  line-height: 1;\n}\n\n.qna-category-title {\n  font-family: var(--font-serif-display);\n  font-size: 1.15rem;\n  font-weight: 600;\n  color: #fff6e5;\n  letter-spacing: 0.02em;\n}\n\n.qna-category-progress {\n  font-size: 0.88rem;\n  color: #e4d6c0;\n  letter-spacing: 0.03em;\n}\n\n.qna-progress-done {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  color: #86efac;\n  font-weight: 500;\n}\n\n/* -----------------------------------------------------------------------------\n   SCREEN 2: QUESTION SCREEN (STAGE + DOCKS)\n   ----------------------------------------------------------------------------- */\n.qna-question-stage {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  position: relative;\n  width: 100%;\n  max-width: 1420px;\n  gap: 24px;\n  padding: 40px 16px;\n}\n\n/* Side Message Docks */\n.qna-message-dock {\n  width: 320px;\n  flex-shrink: 0;\n  transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n  pointer-events: none;\n  opacity: 0;\n}\n\n.qna-message-dock-left {\n  transform: translateX(-35px);\n}\n\n.qna-message-dock-right {\n  transform: translateX(35px);\n}\n\n.qna-message-dock.is-open {\n  opacity: 1;\n  transform: translateX(0);\n  pointer-events: auto;\n}\n\n/* Message Card Styling */\n.qna-message-card {\n  padding: 24px 22px;\n  width: 100%;\n  border: 1px solid rgba(240, 215, 150, 0.65);\n  box-shadow: 0 16px 42px rgba(0, 0, 0, 0.42), 0 0 28px rgba(235, 195, 130, 0.3);\n  animation: qnaFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n.qna-message-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid rgba(235, 200, 140, 0.28);\n  padding-bottom: 12px;\n  margin-bottom: 14px;\n}\n\n.qna-message-badge {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-family: var(--font-serif-display);\n  font-size: 0.95rem;\n  color: #ffe6b3;\n  letter-spacing: 0.03em;\n}\n\n.qna-message-close-btn {\n  background: transparent;\n  border: none;\n  color: #e2d4be;\n  cursor: pointer;\n  padding: 4px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.2s;\n}\n\n.qna-message-close-btn:hover {\n  color: #fff;\n  background: rgba(255, 255, 255, 0.16);\n  transform: scale(1.1);\n}\n\n.qna-message-body {\n  padding: 4px 2px;\n}\n\n.qna-message-text {\n  font-family: var(--font-serif-card);\n  font-size: 1.18rem;\n  line-height: 1.62;\n  color: #fffdf5;\n  font-style: italic;\n  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);\n}\n\n/* Center Question Card */\n.qna-question-card {\n  max-width: 750px;\n  width: 100%;\n  padding: 36px 36px;\n  display: flex;\n  flex-direction: column;\n  gap: 22px;\n}\n\n.qna-question-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid rgba(235, 200, 140, 0.25);\n  padding-bottom: 14px;\n}\n\n.qna-sub-back-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-family: var(--font-sans);\n  font-size: 0.85rem;\n  color: #ebd4b5;\n  background: rgba(255, 255, 255, 0.08);\n  border: 1px solid rgba(235, 200, 140, 0.32);\n  border-radius: 20px;\n  padding: 6px 14px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.qna-sub-back-btn:hover {\n  color: #fff;\n  background: rgba(255, 255, 255, 0.18);\n  border-color: rgba(250, 220, 160, 0.75);\n}\n\n.qna-question-meta {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.qna-cat-badge {\n  font-size: 0.88rem;\n  color: #f5dfbe;\n  font-family: var(--font-serif-display);\n  letter-spacing: 0.02em;\n}\n\n.qna-qnum-badge {\n  font-size: 0.82rem;\n  background: rgba(235, 200, 140, 0.22);\n  border: 1px solid rgba(235, 200, 140, 0.45);\n  border-radius: 12px;\n  padding: 3px 10px;\n  color: #fff8eb;\n  font-weight: 500;\n}\n\n.qna-question-body {\n  text-align: center;\n  padding: 10px 6px;\n}\n\n.qna-question-text {\n  font-family: var(--font-serif-display);\n  font-size: 1.55rem;\n  line-height: 1.45;\n  color: #fffdf8;\n  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);\n  font-weight: 500;\n}\n\n/* 2x2 Answer Options Grid */\n.qna-options-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 16px;\n  margin: 6px 0;\n}\n\n.qna-option-btn {\n  background: rgba(255, 255, 255, 0.08);\n  border: 1px solid rgba(235, 200, 140, 0.32);\n  border-radius: 14px;\n  padding: 18px 18px;\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  cursor: pointer;\n  text-align: left;\n  color: #f8fafc;\n  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n  box-sizing: border-box;\n}\n\n.qna-option-btn:hover {\n  background: rgba(255, 255, 255, 0.16);\n  border-color: rgba(250, 220, 160, 0.78);\n  transform: translateY(-2px);\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28), 0 0 16px rgba(235, 195, 130, 0.28);\n}\n\n.qna-option-btn.is-selected {\n  background: linear-gradient(135deg, rgba(235, 195, 130, 0.26) 0%, rgba(200, 150, 80, 0.26) 100%);\n  border: 1.5px solid rgba(255, 225, 160, 0.95);\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32), 0 0 24px rgba(240, 200, 120, 0.45);\n  transform: translateY(-2px);\n}\n\n.qna-option-emoji {\n  font-size: 1.55rem;\n  line-height: 1;\n  flex-shrink: 0;\n}\n\n.qna-option-text {\n  font-family: var(--font-serif-card);\n  font-size: 1.08rem;\n  line-height: 1.35;\n  color: #fffaf0;\n  font-weight: 500;\n}\n\n/* Footer Navigation */\n.qna-question-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding-top: 14px;\n  border-top: 1px solid rgba(235, 200, 140, 0.22);\n}\n\n.qna-nav-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-family: var(--font-serif-display);\n  font-size: 0.92rem;\n  letter-spacing: 0.05em;\n  color: #fff6e5;\n  background: rgba(235, 200, 140, 0.16);\n  border: 1px solid rgba(235, 200, 140, 0.45);\n  border-radius: 25px;\n  padding: 10px 22px;\n  cursor: pointer;\n  transition: all 0.25s ease;\n}\n\n.qna-nav-btn:hover {\n  background: rgba(235, 200, 140, 0.32);\n  border-color: rgba(255, 225, 160, 0.92);\n  box-shadow: 0 0 20px rgba(235, 195, 130, 0.4);\n  transform: translateY(-1px);\n}\n\n.qna-qnum-indicator {\n  font-family: var(--font-serif-display);\n  font-size: 0.95rem;\n  color: #ebd4b5;\n  letter-spacing: 0.05em;\n}\n\n/* -----------------------------------------------------------------------------\n   SCREEN 3: CATEGORY COMPLETION\n   ----------------------------------------------------------------------------- */\n.qna-completion-card {\n  max-width: 620px;\n  width: 100%;\n  padding: 48px 40px;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 16px;\n}\n\n.qna-completion-icon-wrapper {\n  width: 74px;\n  height: 74px;\n  border-radius: 50%;\n  background: rgba(235, 200, 140, 0.22);\n  border: 1px solid rgba(235, 200, 140, 0.55);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 0 28px rgba(235, 195, 130, 0.38);\n}\n\n.qna-completion-emoji {\n  font-size: 2.5rem;\n  line-height: 1;\n}\n\n.qna-completion-title {\n  font-family: var(--font-serif-display);\n  font-size: 2.05rem;\n  color: #fff8eb;\n  margin-top: 4px;\n}\n\n.qna-completion-category-name {\n  font-family: var(--font-serif-display);\n  font-size: 1.15rem;\n  color: #f5dfbe;\n  font-style: italic;\n}\n\n.qna-completion-message {\n  font-family: var(--font-serif-card);\n  font-size: 1.15rem;\n  line-height: 1.62;\n  color: #fbf5e8;\n  max-width: 480px;\n}\n\n.qna-completion-actions {\n  display: flex;\n  gap: 16px;\n  margin-top: 14px;\n}\n\n.qna-completion-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-family: var(--font-serif-display);\n  font-size: 0.92rem;\n  letter-spacing: 0.04em;\n  padding: 12px 24px;\n  border-radius: 25px;\n  cursor: pointer;\n  transition: all 0.25s ease;\n}\n\n.qna-completion-btn.btn-replay {\n  background: rgba(255, 255, 255, 0.1);\n  border: 1px solid rgba(235, 200, 140, 0.42);\n  color: #fff5e0;\n}\n\n.qna-completion-btn.btn-replay:hover {\n  background: rgba(255, 255, 255, 0.2);\n  border-color: rgba(255, 225, 160, 0.85);\n  transform: translateY(-1px);\n}\n\n.qna-completion-btn.btn-categories {\n  background: rgba(235, 200, 140, 0.28);\n  border: 1px solid rgba(255, 225, 160, 0.88);\n  color: #fff8eb;\n  box-shadow: 0 0 20px rgba(235, 195, 130, 0.38);\n}\n\n.qna-completion-btn.btn-categories:hover {\n  background: rgba(235, 200, 140, 0.42);\n  border-color: #fff;\n  transform: translateY(-1px);\n}\n\n/* Dev button for Q&A */\n.dev-action-btn.qna-btn {\n  background: rgba(244, 63, 94, 0.15);\n  border: 1px solid rgba(244, 63, 94, 0.35);\n  color: #fecdd3;\n}\n\n.dev-action-btn.qna-btn:hover {\n  background: rgba(244, 63, 94, 0.28);\n  border-color: rgba(244, 63, 94, 0.6);\n}\n\n.dev-action-btn.qna-btn.is-active {\n  background: rgba(244, 63, 94, 0.35);\n  border-color: #f43f5e;\n  box-shadow: 0 0 10px rgba(244, 63, 94, 0.3);\n}\n\n/* ==============================================================================\n   SEE THIS VIEW (FULLSCREEN BACKGROUND FEATURE)\n   ============================================================================== */\n\n.see-this-view-container {\n  position: relative;\n  top: auto;\n  right: auto;\n  z-index: 110;\n  display: inline-flex;\n  align-items: center;\n  flex-shrink: 0;\n}\n\n.see-this-view-container.has-dev-controls,\n.see-this-view-container.no-dev-controls {\n  position: relative;\n  top: auto;\n  right: auto;\n}\n\n/* Standalone fallback if rendered outside .top-right-controls-cluster */\n:not(.top-right-controls-cluster) > .see-this-view-container {\n  position: fixed;\n  top: 1rem;\n  right: 1rem;\n}\n:not(.top-right-controls-cluster) > .see-this-view-co