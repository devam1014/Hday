t: 14px; }\n  50%  { height: 6px; }\n  75%  { height: 17px; }\n  100% { height: 4px; }\n}\n\n.music-spectrum-equalizer.is-playing .bar-1  { animation: spectrumWave 0.95s ease-in-out infinite alternate; animation-delay: 0.00s; }\n.music-spectrum-equalizer.is-playing .bar-2  { animation: spectrumWave 1.15s ease-in-out infinite alternate; animation-delay: 0.18s; }\n.music-spectrum-equalizer.is-playing .bar-3  { animation: spectrumWave 0.78s ease-in-out infinite alternate; animation-delay: 0.32s; }\n.music-spectrum-equalizer.is-playing .bar-4  { animation: spectrumWave 1.05s ease-in-out infinite alternate; animation-delay: 0.12s; }\n.music-spectrum-equalizer.is-playing .bar-5  { animation: spectrumWave 0.88s ease-in-out infinite alternate; animation-delay: 0.25s; }\n.music-spectrum-equalizer.is-playing .bar-6  { animation: spectrumWave 1.22s ease-in-out infinite alternate; animation-delay: 0.05s; }\n.music-spectrum-equalizer.is-playing .bar-7  { animation: spectrumWave 0.82s ease-in-out infinite alternate; animation-delay: 0.40s; }\n.music-spectrum-equalizer.is-playing .bar-8  { animation: spectrumWave 1.10s ease-in-out infinite alternate; animation-delay: 0.15s; }\n.music-spectrum-equalizer.is-playing .bar-9  { animation: spectrumWave 0.75s ease-in-out infinite alternate; animation-delay: 0.30s; }\n.music-spectrum-equalizer.is-playing .bar-10 { animation: spectrumWave 1.25s ease-in-out infinite alternate; animation-delay: 0.08s; }\n.music-spectrum-equalizer.is-playing .bar-11 { animation: spectrumWave 0.90s ease-in-out infinite alternate; animation-delay: 0.22s; }\n.music-spectrum-equalizer.is-playing .bar-12 { animation: spectrumWave 1.18s ease-in-out infinite alternate; animation-delay: 0.35s; }\n.music-spectrum-equalizer.is-playing .bar-13 { animation: spectrumWave 0.72s ease-in-out infinite alternate; animation-delay: 0.10s; }\n.music-spectrum-equalizer.is-playing .bar-14 { animation: spectrumWave 1.02s ease-in-out infinite alternate; animation-delay: 0.28s; }\n.mu