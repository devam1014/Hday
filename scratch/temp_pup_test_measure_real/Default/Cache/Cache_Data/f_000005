15, 120, 0.55);\n}\n\n.gallery-nav-arrow:active:not(:disabled) {\n  transform: scale(0.97);\n}\n\n.gallery-nav-arrow:disabled,\n.gallery-nav-arrow.is-disabled {\n  opacity: 0.22;\n  cursor: not-allowed;\n  pointer-events: none;\n  box-shadow: none;\n  border-color: rgba(200, 180, 140, 0.25);\n}\n\n/* Scaled Frame Stage: Scales uniformly as a single unit */\n.sad-frame-stage {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  user-select: none;\n  transition: opacity 300ms ease, transform 320ms cubic-bezier(0.4, 0, 0.2, 1);\n  transform-style: preserve-3d;\n}\n\n/* Opening Album Cover Page: sad-cover inside decorative sad-frame (1269 x 1240) */\n.sad-frame-stage.is-cover-view {\n  width: min(74vw, 524px);\n  aspect-ratio: 1269 / 1240;\n  max-height: min(69vh, 512px);\n  filter: brightness(0.92) drop-shadow(0 18px 40px rgba(0, 0, 0, 0.65)) drop-shadow(0 4px 12px rgba(0, 0, 0, 0.4));\n}\n\n/* Initial Step 1 frame view fallback: sad-frame.png (1269 x 1240) */\n.sad-frame-stage.is-frame-view {\n  width: min(74vw, 524px);\n  aspect-ratio: 1269 / 1240;\n  max-height: min(69vh, 512px);\n  filter: brightness(0.92) drop-shadow(0 18px 40px rgba(0, 0, 0, 0.65)) drop-shadow(0 4px 12px rgba(0, 0, 0, 0.4));\n}\n\n/* Step 2 Photo Display: Compact, Symmetrical Glassmorphism Frame */\n.sad-frame-stage.is-img-view {\n  /* Compact, elegant and balanced outer glass container */\n  width: min(70vw, 500px);\n  max-height: min(72vh, 440px);\n  aspect-ratio: auto;\n  \n  /* Evenly distributed, uniform glass border on all 4 sides */\n  padding: clamp(16px, 2.4vw, 22px);\n  box-sizing: border-box;\n  \n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: space-between;\n  gap: clamp(10px, 1.4vh, 14px);\n  \n  /* Dark navy/black glass tint with very high transparency so background scenery remains clearly visible */\n  background: rgba(12, 18, 30, 0.22);\n  backdrop-filter: blur(6px);\n  -webkit-backdrop-filter: blur(6px);\n  \n  /* Thin, elegant light border */\n  border: 1px solid rgba(255, 255, 255, 0.32);\n  \n  /* Softly rounded corners */\n  border-radius: clamp(16px, 2.4vw, 22px);\n  \n  /* Subtle, refined outer glow and ambient depth */\n  box-shadow: \n    0 0 16px rgba(255, 255, 255, 0.12),\n    0 10px 28px rgba(0, 0, 0, 0.42),\n    inset 0 1px 1px rgba(255, 255, 255, 0.22);\n  \n  filter: none;\n}\n\n/* Smooth 3D Album-Opening & Page-Turn Transition */\n.sad-frame-stage.phase-idle {\n  opacity: 1;\n  transform: perspective(1600px) rotateY(0deg) scale(1);\n}\n\n/* Page turn forward (cover -> img): turns page open to the left */\n.sad-frame-stage.turn-forward.phase-out {\n  opacity: 0;\n  transform: perspective(1600px) rotateY(-70deg) scale(0.95);\n  transform-origin: left center;\n}\n\n.sad-frame-stage.turn-forward.phase-in {\n  opacity: 1;\n  transform: perspective(1600px) rotateY(0deg) scale(1);\n  transform-origin: left center;\n}\n\n/* Page turn backward (img -> cover): folds back and closes album */\n.sad-frame-stage.turn-backward.phase-out {\n  opacity: 0;\n  transform: perspective(1600px) rotateY(50deg) scale(0.95);\n  transform-origin: left center;\n}\n\n.sad-frame-stage.turn-backward.phase-in {\n  opacity: 1;\n  transform: perspective(1600px) rotateY(0deg) scale(1);\n  transform-origin: left center;\n}\n\n/* 1. Photograph Container: Placed BEHIND the frame artwork (z-index: 1) */\n.sad-photo-container {\n  position: absolute;\n  left: 20.4%;\n  top: 14.8%;\n  width: 61.8%;\n  height: 55.6%;\n  overflow: hidden;\n  z-index: 1;\n  background: #110e19;\n  border-radius: 2px;\n}\n\n/* Photograph Image: Fills the opening naturally without distortion */\n.sad-photo-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center center;\n  display: block;\n  transition: opacity 140ms ease;\n}\n\n.sad-photo-img.is-fading {\n  opacity: 0;\n}\n\n/* Fallback placeholder when a photo slot is empty */\n.sad-photo-placeholder {\n  width: 100%;\n  